#!/bin/bash
# ==============================================================
#   PACK_NEW - PERSONALIZACIÓN DE MARCA JAOK04 (PROFESIONAL)
# ==============================================================

# --- VERIFICACIÓN DE SEGURIDAD ---
# Si no existe la IP, significa que no pasó por el instalador oficial
if [[ -z "$IiP" ]]; then
    echo -e "\n\033[1;31m [!] ACCESO DENEGADO: Use el instalador oficial. \033[0m"
    exit 1
fi

# --- CONFIGURACIÓN DE MARCA ---
# Usamos el vendedor que envió el instalador o @Jaok04 por defecto
[[ -z "$BY_USER" ]] && BY_USER="@Jaok04"

# Creamos la carpeta de ejecución y el archivo de éxito para el menú
[[ ! -d /bin/ejecutar ]] && mkdir -p /bin/ejecutar
echo "😎 By $BY_USER 💥" > /bin/ejecutar/exito

# Variables de entorno
SCPdir="/etc/adm-lite"
rm -rf /tmp/* &>/dev/null

# --- FUNCIÓN DE BINARIOS (USERMOD) ---
install_pack_usermod(){
    arch="$(uname -m 2>/dev/null)"
    case "$arch" in
        x86_64)   bin_file="amd64_user.bin" ;;
        aarch64|arm64) bin_file="arm64_user.bin" ;;
        *) bin_file="amd64_user.bin" ;;
    esac

    dst="/etc/ADMcgh/bin/useradd"
    mkdir -p "/etc/ADMcgh/bin"
    
    if [[ -s "${SCPdir}/${bin_file}" ]]; then
        cp -f "${SCPdir}/${bin_file}" "$dst"
        chmod +x "$dst"
        ln -sf "$dst" /bin/add_new_user
    fi
}

# --- INSTALACIÓN DE DEPENDENCIAS ---
install_dependencies() {
    echo -e "\033[1;33m [⚙️] Instalando dependencias del sistema...\033[0m"
    paquetes=(bsdmainutils sudo cron screen nginx nload htop python3 python3-pip nodejs npm lsof psmisc socat bc netcat net-tools jq iptables)
    apt-get update -y &>/dev/null
    for pk in "${paquetes[@]}"; do
        apt-get install -y "$pk" &>/dev/null
    done
    install_pack_usermod
}

# --- CONFIGURACIÓN DEL BANNER Y COMANDOS ---
install_fim () {
    # Crear comandos de acceso rápido
    echo -e "#!/bin/bash\ncd ${SCPdir} && ./menu" > /bin/menu && chmod +x /bin/menu
    echo -e "#!/bin/bash\ncd ${SCPdir} && ./menu" > /bin/cgh && chmod +x /bin/cgh
    echo -e "#!/bin/bash\ncd ${SCPdir} && ./menu \$1" > /bin/adm && chmod +x /bin/adm

    # Personalización del Banner de entrada SSH
    cat <<EOF > /etc/ADMcgh/bashrc
if [ \$(id -u) -eq 0 ]; then
    clear
    echo -e " \033[1;32m🚀 ACCESO AUTORIZADO POR $BY_USER 🚀\033[0m"
    echo -e " ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e " 👤 Cliente IP: \$(curl -s ifconfig.me)"
    echo -e " 📅 Fecha: \$(date +'%d/%m/%Y')"
    echo -e " ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo -e " Escriba: \033[1;43m menu \033[0m para gestionar su servidor."
    echo -e " ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
fi
EOF
    # Activar el banner en el sistema
    sed -i "/ADMcgh\/bashrc/d" /etc/bash.bashrc
    echo "source /etc/ADMcgh/bashrc" >> /etc/bash.bashrc

    # Reiniciar servicios críticos
    systemctl enable --now cron &>/dev/null
    service cron restart &>/dev/null
}

# --- PROCESO FINAL ---
clear
echo -e "\033[1;33m Finalizando configuración de su Script...\033[0m"
install_dependencies
install_fim

echo -e "\033[1;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e "\033[1;32m   INSTALACIÓN COMPLETADA EXITOSAMENTE\033[0m"
echo -e "   CRÉDITOS: \033[1;36m$BY_USER\033[0m"
echo -e "\033[1;33m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
echo -e " Escriba \033[1;32mmenu\033[0m para iniciar."
